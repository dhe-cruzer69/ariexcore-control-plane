{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIEXCORE Fleet Contract",
  "type": "object",
  "required": ["fleet_id", "repos", "policy_level", "evidence_required"],
  "properties": {
    "fleet_id": { "type": "string" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "max_staleness_days": { "type": "integer", "default": 14 }
        }
      }
    },
    "policy_level": { "type": "integer", "minimum": 0, "maximum": 3 },
    "evidence_required": { "type": "boolean", "default": true }
  }
}
